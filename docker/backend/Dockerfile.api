# Dockerfile.api — detecktiv-io API (FastAPI + Alembic + Uvicorn/Gunicorn)
# Dev/local focused, API-only (no frontend). Safe and additive.

FROM python:3.12-slim-bookworm

# -------- Environment hygiene --------
ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1 \
    # Prometheus multiprocess metrics directory (if enabled)
    PROMETHEUS_MULTIPROC_DIR=/tmp/prometheus \
    # Default ports/workers (compose can override)
    API_PORT=8000 \
    PORT=8000 \
    API_WORKERS=1 \
    # Alembic config (env.py builds DB URL from env)
    ALEMBIC_CONFIG=/app/alembic.ini \
    # Ensure modules import cleanly
    PYTHONPATH=/app \
    # Toggle to run Gunicorn instead of Uvicorn (dev default is Uvicorn)
    GUNICORN=0 \
    # Optional Uvicorn reload toggle (compose may set this)
    UVICORN_RELOAD=0

# -------- System deps (runtime-only; keep slim) --------
# curl for healthchecks, wget for compose's healthcheck, libpq for psycopg,
# netcat-openbsd for 'nc' used by docker-compose startup script
ARG DEBIAN_FRONTEND=noninteractive
RUN apt-get update && apt-get install -y --no-install-recommends \
      ca-certificates \
      curl \
      wget \
      libpq5 \
      netcat-openbsd \
  && rm -rf /var/lib/apt/lists/*

# -------- User & directories --------
RUN useradd -m -u 10001 app \
  && mkdir -p /app /tmp/prometheus \
  && chown -R app:app /app /tmp/prometheus

WORKDIR /app

# -------- Python deps first (cache-friendly) --------
# Copy requirement files to leverage Docker layer cache
COPY requirements.txt /app/requirements.txt
# If you keep dev requirements, they’ll be installed conditionally
COPY requirements-dev.txt /app/requirements-dev.txt
RUN python -m pip install --upgrade pip setuptools wheel \
  && pip install -r /app/requirements.txt \
  && if [ -f /app/requirements-dev.txt ]; then pip install -r /app/requirements-dev.txt; fi

# -------- App source (API only; no frontend) --------
# NOTE: .env and secrets are provided by docker-compose; not baked into the image.
COPY . /app
RUN chown -R app:app /app

USER app

# -------- Expose API port (informational) --------
EXPOSE 8000

# -------- Healthcheck (simple liveness via /health) --------
HEALTHCHECK --interval=15s --timeout=4s --start-period=10s --retries=6 \
  CMD curl -fsS "http://127.0.0.1:${PORT:-${API_PORT:-8000}}/health" || exit 1

# -------- Default command --------
# Dev-friendly:
# 1) Optionally run Alembic migrations on boot
# 2) Start Uvicorn by default (set GUNICORN=1 to run Gunicorn)
#
# Env used (override in compose if needed):
#   RUN_MIGRATIONS_ON_BOOT=1|0
#   MIGRATION_TARGET=head (or a specific revision)
#   POSTGRES_* / DATABASE_URL / DB_SCHEMA (picked up by alembic/env.py)
#   UVICORN_RELOAD=1|0
#   GUNICORN=1|0
#
CMD ["/bin/sh", "-lc", "\
  if [ \"${RUN_MIGRATIONS_ON_BOOT:-1}\" = \"1\" ]; then \
    echo '[entrypoint] Running Alembic migrations to ${MIGRATION_TARGET:-head}'; \
    alembic upgrade ${MIGRATION_TARGET:-head}; \
  else \
    echo '[entrypoint] Skipping Alembic migrations (RUN_MIGRATIONS_ON_BOOT!=1)'; \
  fi; \
  if [ \"${GUNICORN:-0}\" = \"1\" ]; then \
    echo '[entrypoint] Starting Gunicorn on 0.0.0.0:'${PORT:-${API_PORT:-8000}}; \
    exec gunicorn app.main:app \
      -k uvicorn.workers.UvicornWorker \
      --bind 0.0.0.0:${PORT:-${API_PORT:-8000}} \
      --workers ${API_WORKERS:-1} \
      --timeout 90 \
      --access-logfile - \
      --error-logfile -; \
  else \
    echo '[entrypoint] Starting Uvicorn on 0.0.0.0:'${PORT:-${API_PORT:-8000}}; \
    exec uvicorn app.main:app \
      --host 0.0.0.0 \
      --port ${PORT:-${API_PORT:-8000}} \
      $([ \"${UVICORN_RELOAD:-0}\" = \"1\" ] && echo \"--reload\"); \
  fi \
"]
